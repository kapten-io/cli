#!/usr/bin/env bash
# Shared pure release metadata and checksum helpers. Source this file.

release_version() {
  local version="${1#v}"
  local identifier
  local identifiers=()
  [[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$ ]] || return 1
  if [[ "$version" == *-* ]]; then
    IFS=. read -r -a identifiers <<<"${version#*-}"
    for identifier in "${identifiers[@]}"; do
      if [[ "$identifier" =~ ^[0-9]+$ && ${#identifier} -gt 1 && "$identifier" == 0* ]]; then
        return 1
      fi
    done
  fi
  printf '%s\n' "$version"
}

# Whether SemVer version $1 sorts after $2 (prereleases before their release).
release_newer() {
  python3 - "$1" "$2" <<'PY'
import sys

def key(version):
    core, _, pre = version.partition("-")
    parts = [int(part) for part in core.split(".")]
    if not pre:
        return parts, (1,)
    identifiers = [(0, int(i), "") if i.isdigit() else (1, 0, i) for i in pre.split(".")]
    return parts, (0, identifiers)

sys.exit(0 if key(sys.argv[1]) > key(sys.argv[2]) else 1)
PY
}

# The version that follows stable version $1 (empty for none yet) given the
# commits on stdin, one "subject<TAB>body" record per NUL: a breaking change
# ("type!:" or a "BREAKING CHANGE:" footer) bumps the major version (the minor
# one before 1.0.0), "feat:" the minor version and anything else but
# ci/docs/test/style the patch version. Prints nothing when nothing ships.
release_next() {
  python3 -c '
import re, sys

latest = sys.argv[1]
records = [r for r in sys.stdin.read().split("\0") if r.strip()]
if not latest:
    print("0.1.0")
    sys.exit()
major, minor, patch = (int(part) for part in latest.split("."))
bump = None
rank = {None: 0, "patch": 1, "minor": 2, "major": 3}
for record in records:
    subject, _, body = record.partition("\t")
    match = re.match(r"([a-z]+)(\([^)]*\))?(!)?:", subject.strip())
    kind = match.group(1) if match else ""
    if (match and match.group(3)) or re.search(r"^BREAKING[ -]CHANGE:", body, re.M):
        level = "major"
    elif kind == "feat":
        level = "minor"
    elif kind in ("ci", "docs", "test", "style"):
        level = None
    else:
        level = "patch"
    if rank[level] > rank[bump]:
        bump = level
if bump == "major" and major == 0:
    bump = "minor"
if bump == "major":
    print(f"{major + 1}.0.0")
elif bump == "minor":
    print(f"{major}.{minor + 1}.0")
elif bump == "patch":
    print(f"{major}.{minor}.{patch + 1}")
' "$1"
}

release_targets() {
  printf '%s\n' darwin/amd64 darwin/arm64 linux/amd64 linux/arm64 windows/amd64 windows/arm64
}

release_assets() {
  local version="$1"
  local target os arch extension archive
  while IFS= read -r target; do
    os="${target%/*}"
    arch="${target#*/}"
    extension=tar.gz
    [[ "$os" != windows ]] || extension=zip
    archive="kapten_${version}_${os}_${arch}.${extension}"
    printf '%s\n' "$archive" "$archive.sbom.json"
  done < <(release_targets)
  printf '%s\n' checksums.txt
}

release_sha256() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{ print $1 }'
  elif command -v shasum >/dev/null; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    echo 'release: required command not found: sha256sum or shasum' >&2
    return 1
  fi
}

release_checksum() {
  local value
  value="$(awk -v file="$2" '$2 == file { print $1 }' "$1")" || return 1
  [[ "$value" =~ ^[0-9a-f]{64}$ ]] || {
    echo "release: missing, duplicate, or invalid checksum for $2" >&2
    return 1
  }
  printf '%s\n' "$value"
}
