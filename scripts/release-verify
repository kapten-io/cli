#!/usr/bin/env bash
# Check a published release as users get it: the archive for this machine
# against checksums.txt and its build provenance, then an install with mise,
# which verifies the packslip signature and digests, and with npx.
set -euo pipefail

usage() {
  echo "usage: mise run release:verify -- vX.Y.Z[-prerelease]" >&2
  exit 2
}

source "$(dirname "$0")/release-common"
[[ $# -eq 1 ]] || usage
version="$(release_version "$1")" || usage
tag="v$version"

for command in curl gh mise npm npx tar; do
  command -v "$command" >/dev/null || {
    echo "release-verify: required command not found: $command" >&2
    exit 1
  }
done

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) echo "release-verify: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac
archive="kapten_${version}_${os}_${arch}.tar.gz"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
base="https://github.com/kapten-io/cli/releases/download/$tag"
curl -fsSL --retry 3 -o "$work/$archive" "$base/$archive"
curl -fsSL --retry 3 -o "$work/checksums.txt" "$base/checksums.txt"

expected="$(release_checksum "$work/checksums.txt" "$archive")"
actual="$(release_sha256 "$work/$archive")"
[[ "$expected" == "$actual" ]] || {
  echo "release-verify: $archive does not match checksums.txt" >&2
  exit 1
}

tar -xzf "$work/$archive" -C "$work"
reported="$("$work/kapten" --version)"
[[ "$reported" == *"$version"* ]] || {
  echo "release-verify: kapten --version printed '$reported', not $version" >&2
  exit 1
}
[[ -x "$work/restish-mcp" ]] || {
  echo "release-verify: $archive has no restish-mcp" >&2
  exit 1
}
gh attestation verify "$work/$archive" --repo kapten-io/cli >/dev/null
echo "Verified $archive and its provenance: $reported"

# A fresh mise data directory, so nothing installed or trusted earlier counts
export MISE_DATA_DIR="$work/mise" MISE_CACHE_DIR="$work/mise-cache"
installed="$(mise exec "packslip:github.com/kapten-io/cli@$version" -- kapten --version)"
[[ "$installed" == "$reported" ]] || {
  echo "release-verify: mise installed '$installed', not '$reported'" >&2
  exit 1
}
echo "Installed with mise (packslip): $installed"

# npm takes a few minutes to serve a new version: wait up to 15 minutes for
# the launcher and every platform package
for name in cli cli-darwin-arm64 cli-darwin-x64 cli-linux-arm64 cli-linux-x64 cli-win32-arm64 cli-win32-x64; do
  for attempt in $(seq 30); do
    npm view "@kapten/$name@$version" version >/dev/null 2>&1 && break
    [[ $attempt -lt 30 ]] || {
      echo "release-verify: npm does not serve @kapten/$name@$version after 15 minutes" >&2
      exit 1
    }
    sleep 30
  done
done

# npm resolves @kapten/cli's platform package for this machine
from_npm="$(cd "$work" && npm_config_cache="$work/npm-cache" npx --yes "@kapten/cli@$version" --version)"
[[ "$from_npm" == "$reported" ]] || {
  echo "release-verify: npx @kapten/cli printed '$from_npm', not '$reported'" >&2
  exit 1
}
echo "Ran with npx (@kapten/cli): $from_npm"
