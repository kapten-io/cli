#!/usr/bin/env bash
# Open or update the pull request of kapten-io/kapten that moves its product
# docs to the CLI release vX.Y.Z: the branch cli-release, rebuilt from master,
# pins the release in docs/product/cli-reference/go.mod and holds the command
# reference and agent skills generated from it.
#
#   release-docs-pr vX.Y.Z
#
# GH_TOKEN may write branches and pull requests of kapten-io/kapten. Needs go.
# With DRY_RUN=1 it pushes nothing and prints the diff instead; KAPTEN_REMOTE
# may then replace the repository URL with a local copy.
set -euo pipefail

source "$(dirname "$0")/release-common"
[[ $# -eq 1 ]] || {
  echo "usage: release-docs-pr vX.Y.Z" >&2
  exit 2
}
version="$(release_version "$1")" || {
  echo "usage: release-docs-pr vX.Y.Z" >&2
  exit 2
}
tag="v$version"
: "${DRY_RUN:=}"
[[ -n "$DRY_RUN" ]] || : "${GH_TOKEN:?GH_TOKEN must be set}"
repo=kapten-io/kapten
branch=cli-release
module=github.com/kapten-io/cli

api() {
  local method="$1" path="$2"
  shift 2
  curl --fail-with-body --silent --show-error --request "$method" \
    --header "Authorization: Bearer $GH_TOKEN" \
    --header "Accept: application/vnd.github+json" \
    --header "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/repos/$repo$path" "$@"
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git clone --quiet --depth 1 --branch master \
  ${GH_TOKEN:+--config "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')"} \
  "${KAPTEN_REMOTE:-https://github.com/$repo.git}" "$work/kapten"
cd "$work/kapten/docs/product/cli-reference"

pinned="$(go list -m -f '{{.Version}}' "$module")"
if [[ "$pinned" == v*.*.* && "$pinned" != *-* ]] && ! release_newer "$version" "${pinned#v}"; then
  echo "kapten's docs already use $pinned, not older than $tag"
  exit 0
fi

# Straight from GitHub: the module proxy and checksum database may not know
# a tag pushed seconds ago
GOPROXY=direct GONOSUMDB="$module" GOFLAGS=-mod=mod go get "$module@$tag"
go mod tidy
go tool kapten-docs ../content/cli/reference
rm -rf ../skills
go tool kapten-docs -skills ../skills
cd "$work/kapten"

title="docs: use the CLI $tag"
git add -A
git -c user.name="kapten-release[bot]" -c user.email="kapten-release[bot]@users.noreply.github.com" \
  commit --quiet -m "$title"
if [[ -n "$DRY_RUN" ]]; then
  git show --stat HEAD
  exit 0
fi
git push --quiet --force origin "HEAD:refs/heads/$branch"

body="Release notes: https://github.com/kapten-io/cli/releases/tag/$tag"
open="$(api GET "/pulls?state=open&head=kapten-io:$branch" | jq -r '.[0].number // empty')"
if [[ -n "$open" ]]; then
  api PATCH "/pulls/$open" --data "$(jq -n --arg t "$title" --arg b "$body" '{title: $t, body: $b}')" >/dev/null
  echo "Updated https://github.com/$repo/pull/$open: $title"
else
  url="$(api POST /pulls --data "$(jq -n --arg t "$title" --arg b "$body" --arg h "$branch" \
    '{title: $t, body: $b, head: $h, base: "master"}')" | jq -r .html_url)"
  echo "Opened $url: $title"
fi
