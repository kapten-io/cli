#!/usr/bin/env bash
# Print the notes of the release of HEAD as version $1: the commits since the
# latest release.
set -euo pipefail

usage() {
  echo "usage: release-notes vX.Y.Z" >&2
  exit 2
}

source "$(dirname "$0")/release-common"
[[ $# -eq 1 ]] || usage
version="$(release_version "$1")" || usage
tag="v$version"

latest="$(release_latest)"
range=HEAD
[[ -z "$latest" ]] || range="$latest..HEAD"
changes="$(git log "$range" --no-merges --format='- %s')"

echo '## Changes'
echo
if [[ -n "$changes" ]]; then
  echo "$changes"
else
  echo '- No changes recorded.'
fi
if [[ -n "$latest" ]]; then
  echo
  echo "**Full changelog**: https://github.com/kapten-io/cli/compare/$latest...$tag"
fi
