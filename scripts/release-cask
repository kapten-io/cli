#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: release-cask vX.Y.Z[-prerelease] OUTPUT" >&2
  exit 2
}

source "$(dirname "$0")/release-common"
[[ $# -eq 2 ]] || usage
version="$(release_version "$1")" || usage
output="$2"

dist="$(dirname "$(dirname "$output")")"
checksums="$dist/checksums.txt"
[[ -f "$checksums" ]] || {
  echo "release-cask: missing $checksums" >&2
  exit 1
}

darwin_amd64="kapten_${version}_darwin_amd64.tar.gz"
darwin_arm64="kapten_${version}_darwin_arm64.tar.gz"
linux_amd64="kapten_${version}_linux_amd64.tar.gz"
linux_arm64="kapten_${version}_linux_arm64.tar.gz"

# Resolve checksums before writing: failure inside a heredoc substitution would
# otherwise leave a successful command with an empty sha256 field.
darwin_amd64_sha="$(release_checksum "$checksums" "$darwin_amd64")"
darwin_arm64_sha="$(release_checksum "$checksums" "$darwin_arm64")"
linux_amd64_sha="$(release_checksum "$checksums" "$linux_amd64")"
linux_arm64_sha="$(release_checksum "$checksums" "$linux_arm64")"

mkdir -p "$(dirname "$output")"
cat >"$output" <<EOF
# This file was generated by scripts/release-cask. DO NOT EDIT.
cask "kapten" do
  version "$version"

  on_macos do
    on_arm do
      sha256 "$darwin_arm64_sha"
      url "https://github.com/kapten-io/cli/releases/download/v#{version}/kapten_#{version}_darwin_arm64.tar.gz"
    end
    on_intel do
      sha256 "$darwin_amd64_sha"
      url "https://github.com/kapten-io/cli/releases/download/v#{version}/kapten_#{version}_darwin_amd64.tar.gz"
    end
  end
  on_linux do
    on_arm do
      sha256 "$linux_arm64_sha"
      url "https://github.com/kapten-io/cli/releases/download/v#{version}/kapten_#{version}_linux_arm64.tar.gz"
    end
    on_intel do
      sha256 "$linux_amd64_sha"
      url "https://github.com/kapten-io/cli/releases/download/v#{version}/kapten_#{version}_linux_amd64.tar.gz"
    end
  end

  name "kapten"
  desc "Manage Kapten resources from the command line"
  homepage "https://github.com/kapten-io/cli"

  livecheck do
    skip "Auto-generated on release."
  end

  binary "kapten"
  binary "restish-mcp"
end
EOF
