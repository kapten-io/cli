#!/usr/bin/env python3
"""Copy the kapten-docs skill that docs.kapten.io publishes into
skills/kapten-docs, after checking it against the digest of the site's agent
skills index. With --check, exit 1 instead when the copy is out of date."""

import hashlib
import json
import pathlib
import sys
import urllib.request

SITE = "https://docs.kapten.io"
INDEX = SITE + "/.well-known/agent-skills/index.json"
TARGET = pathlib.Path(__file__).resolve().parent.parent / "skills" / "kapten-docs" / "SKILL.md"


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "kapten-cli-skills-sync"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read()


def main():
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] not in ([], ["--check"]):
        sys.exit("usage: skills-docs-sync [--check]")
    index = json.loads(fetch(INDEX))
    entry = next((skill for skill in index["skills"] if skill["name"] == "kapten-docs"), None)
    if entry is None or entry.get("type") != "skill-md":
        sys.exit(f"{INDEX} lists no kapten-docs SKILL.md")
    data = fetch(SITE + entry["url"] if entry["url"].startswith("/") else entry["url"])
    algorithm, _, digest = entry["digest"].partition(":")
    if algorithm != "sha256" or hashlib.sha256(data).hexdigest() != digest:
        sys.exit(f"kapten-docs SKILL.md does not match the index digest {entry['digest']}")
    current = TARGET.read_bytes() if TARGET.exists() else b""
    if current == data:
        print("skills/kapten-docs is up to date")
        return
    if check:
        sys.exit("skills/kapten-docs is out of date: run mise run skills:docs and commit the result")
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    TARGET.write_bytes(data)
    print(f"Updated skills/kapten-docs from {SITE}")


if __name__ == "__main__":
    main()
